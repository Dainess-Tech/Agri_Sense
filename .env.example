# Copy to .env and adjust:  cp .env.example .env
# ---------------------------------------------------------------
# PostgreSQL connection (required)
# Default matches the bundled cluster started by `npm run db:start`.
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/app_db

# Public URL of the app (used in email links). Optional in development.
APP_URL=http://localhost:3000

# Email provider for verification / password reset.
# Leave empty for "console mode": links are printed in the server log and
# shown on screen (development only).
MAIL_PROVIDER=
MAIL_API_KEY=
# Optional generic mail webhook (receives JSON { to, subject, text } with the API key as Bearer token).
MAIL_API_URL=

# Web Push (optional). Generate keys with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Set to 1 only if you run production mode over plain http on a LAN
INSECURE_COOKIES=
