{
  "name": "agrisense",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd backend && go run .",
    "start:api": "cd backend && go run .",
    "build:api": "cd backend && go build -o ../dist/agrisense-api .",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/postgres.mjs start",
    "db:stop": "node scripts/postgres.mjs stop",
    "db:status": "node scripts/postgres.mjs status",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "demo:seed": "node scripts/seed-exhibition-demo.mjs",
    "demo:live": "DEMO_STREAM_SEC=600 node scripts/seed-exhibition-demo.mjs",
    "field:seed": "node scripts/seed-exhibition-demo.mjs",
    "field:live": "DEMO_STREAM_SEC=600 node scripts/seed-exhibition-demo.mjs",
    "test:smoke": "bash scripts/test-smoke.sh",
    "test:api": "bash scripts/test-api.sh",
    "test:backend": "bash scripts/test-backend.sh",
    "test:go": "cd backend && go test ./...",
    "test": "npm run test:go && npm run test:smoke && npm run test:api && npm run test:backend"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
